{
    "name": "wireui/wireui",
    "description": "TallStack components",
    "type": "library",
    "keywords": [
        "livewire components",
        "livewire-ui",
        "wireui",
        "laravel components",
        "blade components"
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4|^8.5",
        "laravel/framework": "^10.48|^11.47|^12.53|^13.0",
        "livewire/livewire": "^3.7|^4.2"
    },
    "require-dev": {
        "php": "^8.5",
        "orchestra/testbench": "^10.0",
        "orchestra/testbench-dusk": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-browser": "^4.3"
    },
    "authors": [
        {
            "name": "Pedro Oliveira",
            "email": "pedrolivertwd@gmail.com"
        }
    ],
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "WireUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "vendor/orchestra/testbench-core/laravel/app",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "./vendor/bin/dusk-updater detect --no-interaction"
        ],
        "test": "./vendor/bin/pest",
        "test:ci": "CI=true ./vendor/bin/pest",
        "phpcs": "./vendor/bin/php-cs-fixer fix"
    },
    "extra": {
        "laravel": {
            "providers": [
                "WireUi\\Providers\\WireUiServiceProvider"
            ],
            "aliases": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
